# Copy this file to .env and fill in your values. Never commit .env.

# --- Local AI model (Ollama). Defaults shown; change only if needed.
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_HOST=http://localhost:11434

# --- Email (SMTP). Gmail example: use an App Password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# Optional; defaults to SMTP_USERNAME
EMAIL_FROM=

# --- WhatsApp (Twilio). Sandbox number shown; use your approved sender in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional: path to your contacts list (default: contacts.json)
CONTACTS_FILE=contacts.json
